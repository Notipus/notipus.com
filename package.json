{
  "name": "notipus.com",
  "version": "1.0.0",
  "description": "Notipus - Payment notifications that spark joy",
  "private": true,
  "scripts": {
    "dev": "hugo server --buildDrafts",
    "build": "hugo --minify",
    "clean": "rm -rf public resources",
    "lint": "bun run lint:css && bun run lint:md",
    "lint:css": "stylelint 'assets/**/*.css'",
    "lint:md": "markdownlint 'content/**/*.md' 'README.md'",
    "lint:html": "htmlhint 'layouts/**/*.html'",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.4.23",
    "htmlhint": "^1.8.0",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.20",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.19"
  }
}
